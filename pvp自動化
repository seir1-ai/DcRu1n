-- --- 超特化オートエイム & 物理ロジック ---
local target = nil

-- ターゲット検索を最速ループで実行
rs.Heartbeat:Connect(function()
    local c = p.Character; if not c or not c:FindFirstChild("HumanoidRootPart") then target = nil return end
    local r = c.HumanoidRootPart
    
    local closest, minMag = nil, 500
    for _, plr in pairs(game.Players:GetPlayers()) do
        if plr ~= p and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
            local pRoot = plr.Character.HumanoidRootPart
            local screenPos, onScreen = cam:WorldToViewportPoint(pRoot.Position)
            if onScreen then
                local mag = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)).Magnitude
                if mag < minMag then minMag, closest = mag, pRoot end
            end
        end
    end
    target = closest

    -- スピードブースト & 回避
    if f.speedBoost and c.Humanoid.MoveDirection.Magnitude > 0 then 
        r.AssemblyLinearVelocity = Vector3.new(c.Humanoid.MoveDirection.X*28, r.AssemblyLinearVelocity.Y, c.Humanoid.MoveDirection.Z*28) 
    end
    if (f.autoDodge or f.fullAuto) then
        for _, plr in pairs(game.Players:GetPlayers()) do
            if plr ~= p and plr.Character and plr.Character:FindFirstChild("Bat") and (r.Position - plr.Character.HumanoidRootPart.Position).Magnitude < 10 then
                r.AssemblyLinearVelocity = (r.Position - plr.Character.HumanoidRootPart.Position).Unit * 80 + Vector3.new(0,15,0)
            end
        end
    end
    if f.fullAuto and target and (r.Position - target.Position).Magnitude > 8 then c.Humanoid:MoveTo(target.Position) end
end)

-- カメラ追従をレンダリングフレームに同期 (超滑らか)
rs.RenderStepped:Connect(function()
    if (f.aimbot or f.fullAuto) and target then
        -- 補間(Lerp)を使わず直接書き換えることで「吸い付き」を最大化
        cam.CFrame = CFrame.new(cam.CFrame.Position, target.Position)
    end
end)

-- キルオーラ & ESP
task.spawn(function()
    while task.wait(0.05) do
        if f.killAura or f.fullAuto then
            local b = p.Character:FindFirstChild("Bat") or p.Backpack:FindFirstChild("Bat")
            if b then for _, plr in pairs(game.Players:GetPlayers()) do if plr ~= p and plr.Character and (p.Character.HumanoidRootPart.Position - plr.Character.HumanoidRootPart.Position).Magnitude < 18 then b.Parent = p.Character; b:Activate() end end end
        end
        for _, plr in pairs(game.Players:GetPlayers()) do
            if plr ~= p and plr.Character then
                local hl = plr.Character:FindFirstChild("dcESP")
                if f.esp then if not hl then hl = Instance.new("Highlight", plr.Character); hl.Name = "dcESP" end; hl.FillColor = Color3.fromHSV(tick()%5/5, 1, 1) elseif hl then hl:Destroy() end
            end
        end
    end
end)
